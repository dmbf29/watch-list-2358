<div class="container mt-3 mb-5">
  <h1><%= @list.name %></h1>
  <p>
    <%= link_to 'Add a Movie', new_list_bookmark_path(@list), class: 'btn btn-info'  %>
  </p>
  <% @list.bookmarks.each do |bookmark| %>
    <%= bookmark.comment %>
    <%= bookmark.movie.title %>
  <% end %>
  <%= link_to 'Back', lists_path, class: 'btn btn-secondary'  %>
</div>
